# ── ArtixPOS — environment variables ─────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Core (required) ───────────────────────────────────────────────────────────
DATABASE_URL=postgres://artixpos:yourpassword@localhost:5432/artixpos
SESSION_SECRET=replace-with-a-64-character-random-string-use-openssl-rand-hex-32

# ── OAuth (optional) ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── AI assistant (optional — falls back gracefully if unset) ──────────────────
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=

# ── Email / password reset (optional) ────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_USER=noreply@example.com
SMTP_PASS=
APP_URL=https://yourdomain.com

# ── Cache & rate limiting (optional — falls back to in-memory) ───────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Observability (optional) ──────────────────────────────────────────────────
SENTRY_DSN=
METRICS_TOKEN=

# ── Performance tuning (optional — safe defaults shown) ──────────────────────
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
CLUSTER_WORKERS=0          # 0 = one worker per CPU core
REQUEST_TIMEOUT_MS=30000
SERVER_TIMEOUT_MS=120000
