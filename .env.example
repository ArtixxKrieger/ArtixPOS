# ── ArtixPOS — environment variables ─────────────────────────────────────────
# Run `node scripts/setup.js` to auto-generate this file with a secure
# SESSION_SECRET already filled in. Then set DATABASE_URL and you're ready.
#
# Never commit .env to version control.

# ── Core (required) ───────────────────────────────────────────────────────────
DATABASE_URL=postgres://artixpos:yourpassword@localhost:5432/artixpos
SESSION_SECRET=replace-with-a-64-character-random-string-use-openssl-rand-hex-32

# ── OAuth (optional) ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── AI assistant (optional — falls back gracefully if unset) ──────────────────
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=

# ── Email / password reset (optional) ────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_USER=noreply@example.com
SMTP_PASS=
APP_URL=http://localhost:5000

# ── Payments (optional) ───────────────────────────────────────────────────────
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# ── Cache & rate limiting (optional — falls back to in-memory) ───────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Observability (optional) ──────────────────────────────────────────────────
SENTRY_DSN=
METRICS_TOKEN=

# ── Web Push / PWA notifications (optional) ──────────────────────────────────
# Generate a new VAPID key pair with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@yourdomain.com

# ── Performance tuning (optional — safe defaults shown) ──────────────────────
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
CLUSTER_WORKERS=0
REQUEST_TIMEOUT_MS=30000
SERVER_TIMEOUT_MS=120000
